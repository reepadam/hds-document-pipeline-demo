# Copy this file to .streamlit/secrets.toml and fill in real values.
# In Streamlit Community Cloud, paste these into the "Secrets" UI in the
# app dashboard - they get injected as st.secrets at runtime.
#
# NEVER COMMIT secrets.toml to git. .gitignore already excludes it.

anthropic_api_key = "sk-ant-api03-REPLACE_ME"

# Google Cloud service account JSON.
# Open your cloudvision-XXXX.json file and paste each field below.
[gcp_service_account]
type = "service_account"
project_id = "cloudvision-497116"
private_key_id = "REPLACE_ME"
private_key = """-----BEGIN PRIVATE KEY-----
REPLACE_WITH_FULL_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
client_email = "cloud-vision-api-access-for-hd@cloudvision-497116.iam.gserviceaccount.com"
client_id = "REPLACE_ME"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "REPLACE_ME"
universe_domain = "googleapis.com"
